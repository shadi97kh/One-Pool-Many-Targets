# ---------------------------------------------------------------------------
# Nothing large or third-party is tracked. data/PROVENANCE.json records the
# URL and SHA256 of every excluded file, and scripts/ re-fetches them, so the
# repository stays small without becoming unreproducible.
# ---------------------------------------------------------------------------

# Raw downloads: GEO, GENCODE, RefSeq, OligoFormer. 325 MB.
data/raw/

# Derived caches, regenerated deterministically by the pipeline.
# The accessibility array alone is 153 MB, over GitHub's hard limit.
data/*.parquet
data/*.npz
data/*.tsv
data/*.fa
data/*.gz
data/*.tar

# Publisher PDFs, spreadsheets and archives (197 MB): third-party material.
# The two provenance records in data/lit/ are this project's own writing and
# are deliberately kept, so the negations below come after the directory rule.
data/lit/**
!data/lit/SOURCES.txt
!data/lit/constants/
!data/lit/constants/CONSTANTS_SOURCES.md

# Working files
logs/
__pycache__/
*.pyc
*.pyo
*.part
.ipynb_checkpoints/
.DS_Store

# Internal build specification, kept locally but not published.
docs/

# LaTeX build artefacts. paper/main.tex is generated by scripts/make_paper.py
# and paper/main.pdf is the built manuscript; both are tracked. Nothing else

Formatting_Instructions_For_NeurIPS_2026*.zip

# The manuscript and the tooling that builds it are not part of the
# experimental record and are kept out of the published tree. The repository
# is the experiments, their results and the figures; the manuscript itself is
# released separately once review is complete.
#
# scripts/make_paper.py and scripts/make_bib.py ARE tracked, deliberately.
# The repository claims that every number in the manuscript is generated from
# a result file rather than typed. That claim is only auditable if the
# generator is here to be read, so the generator is part of the experimental
# record even though its output is not.
paper/
Formatting_Instructions_For_NeurIPS_2026*.zip

# Task briefs and prompts. These are instructions to the people and tools that
# built the repository, not part of the experimental record.
PROMPT_*.md
*_BRIEF.md

# Review bundle, built on demand.
riscpool_review.zip

# Review artifacts written for external readers, not inputs to anything.
# make_px_report.py regenerates the two under results/ on demand.
EquiRNA_Claude_Code_Experiments.md
FINAL_SANITY_REPORT.md
REFERENCES_AUDIT.md
results/positive_extensions/REPORT.md
results/positive_extensions/PROPOSED_MANUSCRIPT_ADDITIONS.md
riscpool_review.zip

# Review tooling: produces material for external readers, not experiment
# outputs. Kept in the working tree, out of the repository.
scripts/make_bundle.py
scripts/make_px_report.py
scripts/check_refs_crossref.py
scripts/check_refs_epmc.py
scripts/check_refs_fields.py

# Local environments and validation output.
.pytest_cache/
.venv/
.validation/
reference/
